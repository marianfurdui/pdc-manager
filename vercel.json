{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.js": {
      "includeFiles": "public/**",
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/oauth/callback", "dest": "/api/index?__kind=oauth" },
    { "src": "/api/(.*)", "dest": "/api/index?__kind=api&__path=$1" },
    { "src": "/(.*)", "dest": "/api/index?__kind=static&__path=$1" }
  ]
}
